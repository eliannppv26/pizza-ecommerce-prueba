{
  "kind": "collectionType",
  "collectionName": "combos",
  "info": {
    "singularName": "combo",
    "pluralName": "combos",
    "displayName": "Combo"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "promo_price": {
      "type": "decimal"
    },
    "is_available": {
      "type": "boolean"
    },
    "pizzas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::pizza.pizza",
      "inversedBy": "combos"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "mappedBy": "combos"
    }
  }
}