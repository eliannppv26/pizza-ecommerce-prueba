{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product "
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "price": {
      "type": "decimal"
    },
    "is_available": {
      "type": "boolean"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "drink",
        "side",
        "dessert"
      ]
    },
    "combos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::combo.combo",
      "inversedBy": "products"
    },
    "isFeatured": {
      "type": "boolean"
    }
  }
}
